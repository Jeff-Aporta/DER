{
  "name": "@jeff-aporta/der",
  "version": "0.2.0",
  "exports": {
    ".": "./index.ts",
    "./common": "./src/00-common/index.ts",
    "./objects": "./src/01-objects/index.ts",
    "./client": "./src/02-controllers/client/index.ts",
    "./server": "./src/02-controllers/server/index.ts",
    "./server/sqlite": "./src/02-controllers/server/sqlite.ts",
    "./server/pg": "./src/02-controllers/server/pg.ts",
    "./server/pglite": "./src/02-controllers/server/pglite.ts",
    "./hosts/azure": "./src/02-controllers/server/hosts/azure.ts",
    "./hosts/cloudflare": "./src/02-controllers/server/hosts/cloudflare.ts",
    "./plugins": "./src/03-plugins/index.ts",
    "./plugins/client": "./src/03-plugins/client.ts",
    "./plugins/identity": "./src/03-plugins/identity/index.ts",
    "./plugins/identity/client": "./src/03-plugins/identity/client.ts",
    "./plugins/permissions": "./src/03-plugins/permissions/index.ts",
    "./plugins/permissions/client": "./src/03-plugins/permissions/client.ts"
  },
  "nodeModulesDir": "manual",
  "imports": {
    "@Jeff-Aporta/DER/": "./",
    "@Jeff-Aporta/wc-base/": "https://raw.githubusercontent.com/Jeff-Aporta/is-webcomponents/de72fa6916b42d91ee3e8bfecfbcbeb67c97114d/src/vendor-distributions/shared/",
    "zod": "npm:zod@4.6.7",
    "kysely": "npm:kysely@0.28.17",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@0.3.16",
    "@std/assert": "jsr:@std/assert@1"
  },
  "tasks": {
    "test": "deno test -A",
    "check": "deno check index.ts src/02-controllers/client/index.ts src/02-controllers/server/sqlite.ts src/02-controllers/server/pg.ts src/02-controllers/server/pglite.ts src/02-controllers/server/hosts/azure.ts src/02-controllers/server/hosts/cloudflare.ts src/03-plugins/index.ts src/03-plugins/client.ts examples/ tests/",
    "example": "deno run -A examples/server.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any", "no-slow-types"]
    }
  },
  "fmt": {
    "lineWidth": 110
  }
}
